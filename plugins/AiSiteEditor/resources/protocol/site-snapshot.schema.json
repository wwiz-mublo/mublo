{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mublo.dev/site-editor/site-snapshot.schema.json",
  "title": "Mublo site snapshot",
  "type": "object",
  "required": ["schema_version", "site_revision", "resource_revisions", "skin", "pages", "blocks", "board_groups", "boards", "menus", "site_profile", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "site_revision": {"type": "integer", "minimum": 0},
    "resource_revisions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/resourceId"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "skin": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "brand": {"type": "string"}},
      "additionalProperties": true
    },
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "board_groups": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "boards": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "menus": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "site_profile": {"type": "object"},
    "capabilities": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "resourceId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?::[^:\\s]+)+$"},
    "resource": {
      "type": "object",
      "required": ["resource_id", "revision"],
      "properties": {"resource_id": {"$ref": "#/$defs/resourceId"}, "revision": {"type": "integer", "minimum": 0}},
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "label", "editable"],
      "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "editable": {"type": "boolean"}},
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {"type": "object", "required": ["kind", "position"], "properties": {"kind": {"const": "screen_slot"}, "position": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "page_id"], "properties": {"kind": {"const": "page"}, "page_id": {"type": ["string", "integer"]}}, "additionalProperties": false}
      ]
    },
    "block": {
      "type": "object",
      "required": ["resource_id", "revision", "location", "row", "columns"],
      "properties": {
        "resource_id": {"type": "string", "pattern": "^block_row:[^:\\s]+$"},
        "revision": {"type": "integer", "minimum": 0},
        "section_id": {"type": ["string", "null"]},
        "location": {"$ref": "#/$defs/location"},
        "row": {"type": "object"},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}}
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["resource_id", "contents"],
      "properties": {"resource_id": {"type": "string", "pattern": "^block_column:[^:\\s]+$"}, "contents": {"type": "array", "items": {"$ref": "#/$defs/content"}}},
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["resource_id", "type", "config"],
      "properties": {"resource_id": {"type": "string", "pattern": "^block_content:[^:\\s]+$"}, "type": {"type": "string", "minLength": 1}, "config": {"type": "object"}},
      "additionalProperties": false
    }
  }
}

