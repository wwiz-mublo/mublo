{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/analysis-result-v1.schema.json",
  "title": "Mublo analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "company_id",
    "customer_id",
    "input_cursor",
    "overall_summary",
    "recent_summary",
    "facts",
    "inferences",
    "next_actions",
    "model",
    "prompt_version",
    "created_at",
    "worker_signature"
  ],
  "properties": {
    "schema_version": { "const": "analysis-result-v1" },
    "analysis_id": { "type": "string", "format": "uuid" },
    "company_id": { "type": "string", "format": "uuid" },
    "customer_id": { "type": "string", "format": "uuid" },
    "input_cursor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "overall_summary": { "type": "string", "maxLength": 4000 },
    "recent_summary": { "type": "string", "maxLength": 4000 },
    "stage": { "type": ["string", "null"], "maxLength": 64 },
    "sentiment": { "type": ["string", "null"], "maxLength": 64 },
    "risk": { "type": ["string", "null"], "maxLength": 64 },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "inferences": { "type": "array", "items": { "$ref": "#/$defs/inferenceItem" } },
    "needs": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "objections": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "commitments": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "open_questions": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string", "maxLength": 1000 },
          "reason": { "type": "string", "maxLength": 1000 },
          "recommended_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "message_drafts": { "type": "array", "items": { "type": "string", "maxLength": 4000 } },
    "model": { "type": "string", "maxLength": 128 },
    "prompt_version": { "type": "string", "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "worker_signature": { "type": "string", "minLength": 16, "maxLength": 2048 }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }
      }
    },
    "inferenceItem": {
      "allOf": [
        { "$ref": "#/$defs/evidenceItem" },
        {
          "type": "object",
          "required": ["confidence"],
          "properties": { "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      ]
    }
  }
}
