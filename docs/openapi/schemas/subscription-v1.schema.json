{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm.meccaphone.shop/mublo-ai/schemas/subscription-v1.schema.json",
  "title": "Mublo AI Assistant subscription",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "usage"],
  "properties": {
    "schema_version": { "const": "subscription-v1" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "monthly_price_krw", "customer_limit"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,39}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "monthly_price_krw": { "type": ["integer", "null"], "minimum": 0 },
        "customer_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_customers", "remaining_customers"],
      "properties": {
        "registered_customers": { "type": "integer", "minimum": 0 },
        "remaining_customers": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
