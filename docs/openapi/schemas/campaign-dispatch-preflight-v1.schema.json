{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/campaign-dispatch-preflight-v1.schema.json",
  "title": "Campaign dispatch preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preflight_id", "campaign_id", "snapshot_id", "content_version"],
  "properties": {
    "schema_version": { "const": "campaign-dispatch-preflight-v1" },
    "preflight_id": { "type": "string", "format": "uuid" },
    "campaign_id": { "type": "string", "format": "uuid" },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "content_version": { "type": "integer", "minimum": 1 }
  }
}
