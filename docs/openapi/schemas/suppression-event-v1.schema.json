{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/suppression-event-v1.schema.json",
  "title": "Suppression event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "customer_phone_id", "channel", "action", "reason", "occurred_at", "source", "version"],
  "properties": {
    "schema_version": { "const": "suppression-event-v1" },
    "event_id": { "type": "string", "format": "uuid" },
    "customer_phone_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["SMS", "KAKAO"] },
    "action": { "type": "string", "enum": ["SUPPRESS", "LIFT"] },
    "reason": { "type": "string", "pattern": "^[A-Z0-9_]{3,64}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 }
  }
}
