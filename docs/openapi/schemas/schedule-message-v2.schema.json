{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/schedule-message-v2.schema.json",
  "title": "Mublo schedule message v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schedule_id", "company_id", "customer_id", "customer_phone_id", "channel", "message_class", "content", "content_version", "status", "scheduled_at", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "schedule-message-v2" },
    "schedule_id": { "type": "string", "format": "uuid" },
    "company_id": { "type": "string", "format": "uuid" },
    "customer_id": { "type": "string", "format": "uuid" },
    "customer_phone_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["DEVICE_SIM", "DEVICE_KAKAO", "SENDON_SMS", "SENDON_ALIMTALK"] },
    "message_class": { "type": "string", "enum": ["TRANSACTIONAL", "MARKETING"] },
    "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "content_version": { "type": "integer", "minimum": 1 },
    "approved_content_version": { "type": ["integer", "null"], "minimum": 1 },
    "permission_version": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "DISPATCHING", "SENT", "FAILED", "BLOCKED", "CANCELED"] },
    "scheduled_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
