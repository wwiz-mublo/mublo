{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/worker-job-v2.schema.json",
  "title": "Leased customer analysis job v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "run_id", "manifest", "lease_token", "lease_expires_at", "attempt"],
  "properties": {
    "schema_version": { "const": "worker-job-v2" },
    "job_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "manifest": { "$ref": "analysis-manifest-v1.schema.json" },
    "lease_token": { "type": "string", "minLength": 32, "maxLength": 512 },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 }
  }
}
