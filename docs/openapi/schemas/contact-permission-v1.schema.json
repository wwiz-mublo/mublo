{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/contact-permission-v1.schema.json",
  "title": "Contact permission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "customer_phone_id", "channel", "purpose", "status", "legal_basis", "captured_at", "source", "version"],
  "properties": {
    "schema_version": { "const": "contact-permission-v1" },
    "permission_id": { "type": "string", "format": "uuid" },
    "customer_phone_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["SMS", "KAKAO"] },
    "purpose": { "type": "string", "enum": ["MARKETING", "SERVICE_NOTICE"] },
    "status": { "type": "string", "enum": ["CONSENTED", "REVOKED", "NOT_REQUIRED"] },
    "legal_basis": { "type": "string", "enum": ["EXPLICIT_CONSENT", "EXISTING_TRANSACTION", "CONTRACT_FULFILLMENT", "MANUAL_REVIEW"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
