{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/worker-heartbeat-v1.schema.json",
  "title": "Worker heartbeat v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_id", "service_version", "build_digest", "status", "capabilities", "max_concurrency", "active_jobs", "progress_sequence"],
  "properties": {
    "schema_version": { "const": "worker-heartbeat-v1" },
    "worker_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "service_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "build_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "type": "string", "enum": ["STARTING", "READY", "BUSY", "DRAINING", "DEGRADED"] },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["CUSTOMER_PROFILE_ANALYSIS_V2"] } },
    "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
    "active_jobs": { "type": "integer", "minimum": 0, "maximum": 64 },
    "progress_sequence": { "type": "integer", "minimum": 0 },
    "encryption_key_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "signing_key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "certificate_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disk_free_bytes": { "type": "integer", "minimum": 0 },
    "cleanup_healthy": { "type": "boolean" }
  }
}
