{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.mublo.ai/schemas/interaction-upload-v3.schema.json",
  "title": "Multi-channel encrypted interaction upload v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interaction_id", "customer_id", "customer_phone_id", "device_id", "channel", "source_record_id", "occurred_at", "content_sha256", "envelope"],
  "properties": {
    "schema_version": { "const": "interaction-upload-v3" },
    "interaction_id": { "type": "string", "format": "uuid" },
    "customer_id": { "type": "string", "format": "uuid" },
    "customer_phone_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["CALL_TRANSCRIPT", "SMS", "KAKAO", "VOICE_MEMO"] },
    "source_record_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "direction": { "type": ["string", "null"], "enum": ["INCOMING", "OUTGOING", "UNKNOWN", null] },
    "duration_sec": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "envelope": { "$ref": "crypto-envelope-v1.schema.json" }
  }
}
